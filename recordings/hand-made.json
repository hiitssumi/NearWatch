      "agent": "rules",
      "tokens": {
        "input": 1500,
        "output": 420
      },
      "answer": {
        "rules": [
          {
            "id": "R1",
            "text": "A withdrawal lowers the caller's recorded balance only by an amount the named receiver actually received.",
            "check": {
              "methods": [
                "withdraw"
              ],
              "slots": [
                {
                  "name": "user_recorded",
                  "kind": "view",
                  "describe": "the caller's balance as recorded by the contract",
                  "bind": {
                    "view": {
                      "method": "balance_of",
                      "args": {
                        "account_id": "$caller"
                      }
                    }
                  }
                },
                {
                  "name": "receiver_wallet",
                  "kind": "balance",
                  "describe": "the NEAR balance of the receiver named in the withdrawal",
                  "bind": {
                    "account": "$arg:receiver_id"
                  }
                }
              ],
              "condition": {
                "compare": ">",
                "left": {
                  "op": "sub",
                  "left": {
                    "slot": "user_recorded",
                    "when": "before"
                  },
                  "right": {
                    "slot": "user_recorded",
                    "when": "after"
                  }
                },
                "right": {
                  "op": "add",
                  "left": {
                    "op": "sub",
                    "left": {
                      "slot": "receiver_wallet",
                      "when": "after"
                    },
                    "right": {
                      "slot": "receiver_wallet",
                      "when": "before"
                    }
                  },
                  "right": {
                    "number": "100000000000000000000000"
                  }
                }
              }
            }
          },
          {
            "id": "R2",
            "text": "The owner cannot reduce any user's balance.",
            "check": {
              "methods": [
                "set_deposits_paused"
              ],
              "slots": [
                {
                  "name": "user_recorded",
                  "kind": "view",
                  "describe": "the recorded balance of an account named user",
                  "bind": {
                    "view": {
                      "method": "balance_of",
                      "args": {
                        "account_id": "user"
                      }
                    }
                  }
                }
              ],
              "condition": {
                "compare": "<",
                "left": {
                  "slot": "user_recorded",
                  "when": "after"
                },
                "right": {
                  "slot": "user_recorded",
                  "when": "before"
                }
              }
            }
          }
        ]
      }
    },
